# Production environment template
# Copy this file to .env on your server, then fill in real values.

NODE_ENV=production
PORT=3000

# IMPORTANT: set your real domain, do not use * in production.
CORS_ORIGIN=https://your-domain.com

# PostgreSQL connection (local DB on server)
DATABASE_URL=postgresql://todolist_app:replace-with-strong-password@127.0.0.1:5432/todolist
DB_SSL=false

# Auth
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=7d

# Disable open registration in production unless you really need it.
PUBLIC_SIGNUP_ENABLED=false

# Optional bootstrap admin (created/updated on startup)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-strong-admin-password

# Required encryption key for sync payloads
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_ENCRYPTION_KEY=replace-with-64-char-hex

# Optional AI provider keys
ZHIPU_API_KEY=
NVIDIA_API_KEY=
