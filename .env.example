# HTTP
PORT=3000

# CORS
# Use '*' for dev, or comma-separated origins for production.
CORS_ORIGIN=*

# AI provider keys
ZHIPU_API_KEY=
NVIDIA_API_KEY=

# PostgreSQL
DATABASE_URL=postgresql://app_user:strong_password@127.0.0.1:5432/todolist
DB_SSL=false

# Auth (JWT)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Public registration toggle (recommended false in production)
PUBLIC_SIGNUP_ENABLED=false

# Optional bootstrap admin account (created/updated at startup)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-please

# Data confidentiality key for sync payload encryption
# Use 64-char HEX (32 bytes) or base64 for 32-byte key.
SYNC_ENCRYPTION_KEY=replace-with-64-char-hex-or-base64-key
