[Unit]
Description=Toolbox TodoList API Service
After=network.target postgresql.service
Wants=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/todolist
Environment=NODE_ENV=production
EnvironmentFile=/srv/todolist/.env
ExecStart=/usr/bin/node /srv/todolist/server.js
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/todolist

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
